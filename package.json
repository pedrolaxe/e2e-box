{
  "name": "e2e-box",
  "version": "1.0.0",
  "description": "End-to-end testing for native Android apps over adb, with Maestro-style YAML flows, a local dashboard with live device mirroring, a flow recorder and a CLI for CI",
  "keywords": [
    "android",
    "adb",
    "e2e",
    "e2e-testing",
    "maestro",
    "yaml",
    "test-automation",
    "mobile-testing",
    "uiautomator",
    "react-native",
    "expo",
    "nextjs"
  ],
  "homepage": "https://github.com/pedrolaxe/e2e-box#readme",
  "bugs": {
    "url": "https://github.com/pedrolaxe/e2e-box/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrolaxe/e2e-box.git"
  },
  "license": "MIT",
  "author": {
    "name": "Pedro Laxe",
    "email": "pedrolaxe@gmail.com",
    "url": "https://github.com/pedrolaxe"
  },
  "engines": {
    "node": ">=18.18"
  },
  "bin": {
    "e2e-box": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "agent/dist/e2e-box-agent.jar"
  ],
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3334",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3334",
    "e2e": "tsx bin/e2e-box.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build:cli"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.12",
    "fast-xml-parser": "^5.2.5",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  }
}
